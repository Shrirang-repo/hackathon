# ==============================================================================
# AI-Based Landslide Risk Monitoring System - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="AI-Based Landslide Risk Monitoring System"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. React/Vite/Next.js)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL / Supabase)
# Replace with your PostgreSQL or Supabase Connection String:
# Example: postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landslide_db"

# Optional SQLite fallback for offline local testing without running PostgreSQL:
# DATABASE_URL="sqlite:///./landslide_risk.db"

# Supabase Credentials (optional for direct Supabase REST/Auth integrations)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# AI Model Service Configuration
USE_AI_SERVICE_MOCK=True
AI_MODEL_CONFIDENCE_THRESHOLD=0.75
